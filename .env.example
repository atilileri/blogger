# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_token_here

# API Server Configuration
API_SERVER_IP=localhost
API_PORT=8000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Ngrok Configuration
NGROK_AUTH_TOKEN=your_ngrok_auth_token_here
STATIC_DOMAIN=your_static_domain_here

# Security
ALLOWED_CHAT_IDS=123456789,987654321

# LLM (Gemini Flash)
GOOGLE_API_KEY=your_google_api_key_here

# Worker
CHECKPOINT_DB=/opt/blogger/checkpoints.sqlite

# GitOps
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO=target_to_push_posts
BLOG_CONTENT_PATH=src/content/blog
BLOG_IMAGES_PATH=public/images/blog

# Image Generation
IMAGE_API_PROVIDER=pollinations
